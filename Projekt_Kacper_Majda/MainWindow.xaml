<Window x:Class="Projekt_Kacper_Majda.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Projekt_Kacper_Majda"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="7*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>

        <Label Grid.Column="0" Grid.Row="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontSize="15" Grid.ColumnSpan="3">Symulacja rzutu ukośnego</Label>
        <!-- ___________masa___________ -->
        <Label Grid.Column="0" Grid.Row="1" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">Masa:</Label>
        <TextBox Grid.Column="1" Grid.Row="1" x:Name="massInput"></TextBox>
        <Label Grid.Column="2" Grid.Row="1" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">kg</Label>
        <!-- ___________wysokosc___________ -->
        <Label Grid.Column="0" Grid.Row="2" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">Wysokość:</Label>
        <TextBox Grid.Column="1" Grid.Row="2" x:Name="heightInput"></TextBox>
        <Label Grid.Column="2" Grid.Row="2" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">m</Label>
        <!-- ___________Prędkość startowa___________ -->
        <Label Grid.Column="0" Grid.Row="3" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">Prędkość Startowa:</Label>
        <TextBox Grid.Column="1" Grid.Row="3" x:Name="startVelocityInput"></TextBox>
        <Label Grid.Column="2" Grid.Row="3" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">m/s</Label>
        <!-- ___________Kąt___________ -->
        <Label Grid.Column="0" Grid.Row="4" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">Kąt:</Label>
        <TextBox Grid.Column="1" Grid.Row="4" x:Name="angleInput"></TextBox>
        <Label Grid.Column="2" Grid.Row="4" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">stopni</Label>

        <!-- ___________krok czasu___________ -->
        <Label Grid.Column="0" Grid.Row="5" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">Krok czasu dt:</Label>
        <TextBox Grid.Column="1" Grid.Row="5" x:Name="dtInput"></TextBox>
        <Label Grid.Column="2" Grid.Row="5" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">s</Label>
        <!-- ___________Grawitacja___________ -->
        <Label Grid.Column="0" Grid.Row="6" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">Grawitacja:</Label>
        <TextBox Grid.Column="1" Grid.Row="6" x:Name="gravityInput"></TextBox>
        <Label Grid.Column="2" Grid.Row="6" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">m/s^2</Label>

        <!-- ___________ Startowanie symulacji ______________ -->
        <Button Grid.ColumnSpan="2" Grid.Column="0" Grid.Row="7" Margin="5" Click="Button_Click">Uruchom symulację</Button>

        <!-- ___________ Wyniki: ___________________ -->
        <Label Grid.Column="0" Grid.Row="8"  VerticalContentAlignment="Center" HorizontalAlignment="Center">Wyniki:</Label>

        <!-- ___________ Czas lotu: ________________ -->
        <Label Grid.Column="0" Grid.Row="9" VerticalContentAlignment="Center" HorizontalAlignment="Center">Czas Lotu:</Label>
        <Label Grid.Column="1" Grid.Row="9" VerticalContentAlignment="Center" HorizontalAlignment="Center" x:Name="flightTimeLbl">...</Label>

        <!-- ___________ Zasięg: ________________ -->
        <Label Grid.Column="0" Grid.Row="10" VerticalContentAlignment="Center" HorizontalAlignment="Center">Zasięg:</Label>
        <Label Grid.Column="1" Grid.Row="10" VerticalContentAlignment="Center" HorizontalAlignment="Center" x:Name="roadLbl">...</Label>

        <!-- ___________ Czas lotu: ________________ -->
        <Label Grid.Column="0" Grid.Row="11" VerticalContentAlignment="Center" HorizontalAlignment="Center">Maks. wysokość:</Label>
        <Label Grid.Column="1" Grid.Row="11" VerticalContentAlignment="Center" HorizontalAlignment="Center" x:Name="maksHeightLbl">...</Label>
        <!-- ______________Wykres_____________ -->
        <lvc:CartesianChart x:Name="trajectoryChart" HorizontalAlignment="Center" VerticalAlignment="Top" Grid.Column="3" Grid.Row="0" Grid.RowSpan="9" Series="{Binding Series}" LegendPosition="Bottom" Height="300" Width="300"/>
        <RadioButton Grid.Column="1" Content="Euler" HorizontalAlignment="Left" Margin="0,33,0,0" Grid.Row="7" VerticalAlignment="Top" Grid.RowSpan="2" Click="RadioButton_Click"/>
        <RadioButton Grid.Column="1" Content="Analityczna" HorizontalAlignment="Left" Margin="0,15,0,0" Grid.Row="8" VerticalAlignment="Top" Click="RadioButton_Click_1"/>

        <RadioButton FontSize="15" Grid.Column="3" Content="Wykres błędu" HorizontalAlignment="Center" Margin="0,33,0,0" Grid.Row="10" VerticalAlignment="Top" Grid.RowSpan="2" Click="RadioButton_Click_2"/>
        <RadioButton FontSize="15" Grid.Column="3" Content="Wykres metod" HorizontalAlignment="Center" Margin="0,15,0,0" Grid.Row="10" VerticalAlignment="Top" Click="RadioButton_Click_3"/>
    </Grid>
</Window>
